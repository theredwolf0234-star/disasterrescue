# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Leave empty for local zero-config SQLite persistence (stored in backend/data/rescue_ai.db)
# Or provide a PostgreSQL connection URL for production:
# DATABASE_URL=postgresql://user:password@host:5432/rescue_ai_db
DATABASE_URL=

# JWT Authentication Secret (MUST change in production)
JWT_SECRET=rescue_ai_super_secret_jwt_key_2026_dev_mode

# CORS & Socket.IO Allowed Origins
FRONTEND_URL=*
SOCKET_ORIGIN=*

# WeatherAPI.com Key (Optional - WeatherAPI.com preferred, Open-Meteo fallback is default free)
WEATHERAPI_KEY=

# Mapbox Access Token (Optional - Leave empty to use default OpenStreetMap/CartoDB tiles)
MAPBOX_ACCESS_TOKEN=your_mapbox_public_token_here

# National Disaster Response Force (NDRF) Integration Bridge
# Set to 'true' to enable the NDRF Common Alerting Protocol (CAP) and CAD Gateway
NDRF_GATEWAY_ENABLED=true
# Optional external CAD / Webhook endpoint URL (Leave blank to use built-in high-fidelity EOC simulator)
NDRF_GATEWAY_URL=
# Optional external API key / bearer token for NDRF CAD authentication
NDRF_API_KEY=
# Regional Command Node Identifier
NDRF_HQ_NODE=NDRF-HQ-DELHI-01
# Automatically relay all CRITICAL and HIGH severity distress beacons to NDRF EOC
NDRF_AUTO_RELAY_CRITICAL=true
